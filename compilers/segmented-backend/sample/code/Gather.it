Program (args) {
	gEnv = new TaskEnvironment(name: "MPI Gather Experiment")
	execute(task: "MPI Gather Experiment"; environment: gEnv; initialize: args.s; partition: args.p, args.q)
	bind_output(gEnv, "vector" , args.output_file)
}

Task "MPI Gather Experiment":
	Define:
		vector: 1d Array of Integer
	Environment:
		vector: create
	Initialize(size):
		vector.dimension1.range.min = 0
		vector.dimension1.range.max = size - 1
	Stages:
		init_vector(v) {
			do {
				v[i] = i
			} for i in v
		}
		add_one(v) {
			do {
				v[i] = v[i] + 1
			} for i in v
		}
	Computation:
		Space A {
			Space C {
				init_vector(vector)
				
			}
			add_one(vector)
		}
	Partition(p, q):
		Space A <un-partitioned> { vector }
		Space B <1d> divides Space A partitions {
			vector<dim1>: block_count(p)
		}
		Space C <1d> divides Space B partitions {
			vector<dim1>: block_size(q)
		}
